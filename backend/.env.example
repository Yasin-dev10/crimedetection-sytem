PORT=5000
# Production: use authenticated MongoDB / Atlas with TLS, e.g.
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/crime_detection_system?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/crime_detection_system

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here
JWT_EXPIRES_IN=12h

FACEBOOK_ACCESS_TOKEN=
FACEBOOK_MONITOR_INTERVAL_MS=60000

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
FRONTEND_URL=http://localhost:5173
LOGIN_OTP_ENABLED=true

# Required to use POST /api/auth/register-admin (one-time bootstrap). Leave empty to disable the endpoint.
ADMIN_BOOTSTRAP_SECRET=

# Shared secret for Express → Flask AI calls
AI_MODEL_URL=http://127.0.0.1:5001/predict
AI_MODEL_API_KEY=generate_a_long_random_shared_secret
AI_MODEL_TIMEOUT_MS=30000
# Optional integrity check for ai-model/*.pkl (sha256 hex)
# AI_MODEL_SHA256=

# Twilio Verify (optional — SMS phone verification in Settings)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=

# Twilio SMS alerts (optional — SMS when investigator is assigned a case)
TWILIO_PHONE_NUMBER=
# Or use a Messaging Service instead of TWILIO_PHONE_NUMBER:
# TWILIO_MESSAGING_SERVICE_SID=

# seedAdmin.js — never commit real production passwords
ADMIN_EMAIL=
ADMIN_PASSWORD=

# seedDatasetManager.js - private Dataset Manager account
DATASET_MANAGER_NAME=BAREAI Dataset Manager
DATASET_MANAGER_EMAIL=
DATASET_MANAGER_PASSWORD=

PUPPETEER_NO_SANDBOX=false
TRUST_PROXY=0
